# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here is needed for packets P0 or P1 - those run with no infrastructure at all.

# --- Postgres (docker-compose reads these) ---
# Postgres is on 5434 and Redis on 6380 - see docker-compose.yml for why.
DATASOURCE_URL=jdbc:postgresql://localhost:5434/budget
POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
# Redis is on 6380, not the default 6379, because the jobs-tracker stack on this machine holds 6379.
REDIS_PORT=6380

# --- Cost-of-living data sources ---
# NOT NEEDED IN v1. The BLS/BEA/Census pipeline is deferred; see
# .claude/packets/P9-DEFERRED-official-cost-of-living.md. v1 uses curated seed data.
# BEA Regional Price Parities: free, instant signup at https://apps.bea.gov/API/signup/
BEA_API_KEY=
# Census ACS B25064 median gross rent: free at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# BLS Consumer Expenditure Survey via LABSTAT: a key raises the daily quota but is not required
BLS_API_KEY=

# --- Bank data (packet P3) ---
# Plaid Sandbox, free at https://dashboard.plaid.com. Sandbox only - never put production keys here.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# The sandbox user with checking, credit-card AND loan accounts. user_good lacks the credit and
# loan accounts that the credit-card double-count tests need.
PLAID_SANDBOX_USER=user_transactions_dynamic

# --- Auth (packets P4 and P6) ---
# Supabase free tier at https://supabase.com
SUPABASE_URL=
SUPABASE_JWKS_URI=
SUPABASE_ANON_KEY=

# --- Encryption ---
# Used to encrypt stored bank access tokens at rest. Generate a random 32-byte value.
TOKEN_ENCRYPTION_KEY=
